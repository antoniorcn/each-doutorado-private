#VRML V2.0 utf8

# A directional light source, shining down from above
DirectionalLight {
  direction 0 -1 0
}

# A simple red cube
Transform {
  translation 0 0 -5  # Move the cube back on the z-axis
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 1 1  # Red color
        }
      }
      geometry Box {
        size 2 2 2  # Dimensions (width, height, depth)
      }
    }
  ]
}